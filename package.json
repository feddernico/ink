{
  "name": "ink",
  "version": "1.1.4",
  "description": "Ink is a functional and minimalistic webapp to write documents in markdown and export them",
  "homepage": "https://github.com/feddernico/ink#readme",
  "bugs": {
    "url": "https://github.com/feddernico/ink/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feddernico/ink.git"
  },
  "license": "MIT",
  "author": "Federico Viscioletti",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "build": "npm run lint && node build/compile-and-assemble.js",
    "watch": "node build/watch.js",
    "build:favicon": "node build/generate-favicons.js",
    "build:test": "node build/build-test.js",
    "test:qunit": "npm run build:test && qunit \"tests/qunit/**/*.test.js\"",
    "serve:test": "http-server . -p 4173 -s",
    "test:cypress": "start-server-and-test \"npm run serve:test\" http://127.0.0.1:4173/ink-app.html \"unset ELECTRON_RUN_AS_NODE; cypress run\"",
    "test:cypress:open": "unset ELECTRON_RUN_AS_NODE; cypress open",
    "test": "npm run test:qunit && npm run test:cypress"
  },
  "devDependencies": {
    "@babel/standalone": "^7.29.2",
    "@cypress/code-coverage": "^4.0.2",
    "babel-plugin-istanbul": "^7.0.1",
    "chokidar": "^4.0.3",
    "cypress": "^15.12.0",
    "esbuild": "^0.27.3",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "http-server": "^14.1.1",
    "nyc": "^18.0.0",
    "qunit": "^2.24.2",
    "sass": "^1.97.3",
    "start-server-and-test": "^2.0.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "marked": "^17.0.4"
  },
  "overrides": {
    "immutable": "^5.1.5"
  }
}
