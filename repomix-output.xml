    cy.get("#editor").clear().type(markdown);
    cy.window().then((win) => {
      dispatchShortcut(win, { key: "s", ctrlKey: true });
    });
    cy.get("#statusBadge").should("contain", "Saved");

    cy.window().then((win) => {
