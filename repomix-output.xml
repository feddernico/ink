              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon"><path d="M12 3a6 6 0 0 0 9 9"/><path d="M19 12a7 7 0 1 1-7-7"/></svg>
              <span class="menu-label-text">Twilight</span>
