      cy.get("body").then(($body) => {
        const exportMdBtn = $body.find("#exportMdBtn");
        expect(exportMdBtn.length).to.eq(0);
      });
    });

    it("5.4 #newNoteBtn, #newFolderBtn, and #openFolderBtn are NOT present in ink-app.html", () => {
