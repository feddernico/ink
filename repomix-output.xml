<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>ink - Markdown Notes & Documents</title>
  <link rel="icon" type="image/svg+xml" href="assets/branding/favicon.svg" />
  <link rel="shortcut icon" href="assets/branding/favicon.svg" />

  <style>
/*__INLINE_CSS__*/
  </style>
</head>

<body>
  <div id="app" class="app">
    <!-- Menu Bar -->
    <nav id="menuBar" class="card menubar" role="menubar" aria-label="Application menu">
      <div class="menu-item" role="menuitem" aria-haspopup="true" aria-expanded="false" tabindex="0">
        <span class="menu-text">File</span>
        <span class="menu-arrow">▼</span>
        <ul class="dropdown" role="menu" aria-label="File menu">
          <li role="menuitem" tabindex="-1" data-action="new-note">
            <span class="menu-label">New Note</span>
            <span class="menu-shortcut">Cmd/Ctrl+E</span>
          </li>
          <li role="menuitem" tabindex="-1" data-action="new-folder">
            <span class="menu-label">New Folder</span>
          </li>
          <li role="menuitem" tabindex="-1" data-action="open-workspace">
            <span class="menu-label">Open Workspace</span>
            <span class="menu-shortcut">Cmd/Ctrl+Shift+O</span>
          </li>
          <li role="menuitem" tabindex="-1" data-action="close-workspace">
            <span class="menu-label">Close Workspace</span>
          </li>
          <li role="separator" aria-hidden="true"></li>
          <li class="submenu-parent" role="menuitem" aria-haspopup="true" aria-expanded="false" tabindex="0">
            <span class="menu-label">Export</span>
            <span class="menu-arrow">▶</span>
            <ul class="dropdown submenu" role="menu" aria-label="Export submenu">
              <li role="menuitem" tabindex="-1" data-action="export-json">
                <span class="menu-label">Export JSON</span>
                <span class="menu-shortcut">Ctrl+Shift+S</span>
              </li>
              <li role="menuitem" tabindex="-1" data-action="export-markdown">
                <span class="menu-label">Export Markdown</span>
                <span class="menu-shortcut">Ctrl+Shift+M</span>
              </li>
            </ul>
          </li>
          <li role="separator" aria-hidden="true"></li>
          <li role="menuitem" tabindex="-1" data-action="exit">
            <span class="menu-label">Exit</span>
          </li>
        </ul>
      </div>
      
      <div class="menu-item" role="menuitem" aria-haspopup="true" aria-expanded="false" tabindex="0">
        <span class="menu-text">Edit</span>
        <span class="menu-arrow">▼</span>
        <ul class="dropdown" role="menu" aria-label="Edit menu">
          <li role="menuitem" tabindex="-1" data-action="save">
            <span class="menu-label">Save</span>
            <span class="menu-shortcut">Ctrl+S</span>
          </li>
          <li role="menuitem" tabindex="-1" data-action="save-as">
            <span class="menu-label">Save As...</span>
          </li>
          <li role="separator" aria-hidden="true"></li>
          <li role="menuitem" tabindex="-1" data-action="refresh">
            <span class="menu-label">Refresh</span>
            <span class="menu-shortcut">Cmd/Ctrl+L</span>
          </li>
          <li role="menuitem" tabindex="-1" data-action="sort">
            <span class="menu-label">Sort: Name</span>
          </li>
        </ul>
      </div>
      
      <div class="menu-item" role="menuitem" aria-haspopup="true" aria-expanded="false" tabindex="0">
        <span class="menu-text">View</span>
        <span class="menu-arrow">▼</span>
        <ul class="dropdown" role="menu" aria-label="View menu">
          <li role="menuitem" tabindex="-1" data-action="theme-default">
            <span class="menu-label">Default (Dark)</span>
            <span class="menu-theme-check" id="themeCheck-default">✓</span>
          </li>
          <li role="separator" aria-hidden="true"></li>
          <li role="menuitem" tabindex="-1" data-action="theme-classic">
            <span class="menu-label">Classic</span>
            <span class="menu-theme-check" id="themeCheck-classic">✓</span>
          </li>
          <li role="menuitem" tabindex="-1" data-action="theme-cobalt">
            <span class="menu-label">Cobalt</span>
            <span class="menu-theme-check" id="themeCheck-cobalt">✓</span>
          </li>
          <li role="menuitem" tabindex="-1" data-action="theme-monokai">
            <span class="menu-label">Monokai</span>
            <span class="menu-theme-check" id="themeCheck-monokai">✓</span>
          </li>
          <li role="menuitem" tabindex="-1" data-action="theme-office">
            <span class="menu-label">Office</span>
            <span class="menu-theme-check" id="themeCheck-office">✓</span>
          </li>
          <li role="menuitem" tabindex="-1" data-action="theme-twilight">
            <span class="menu-label">Twilight</span>
            <span class="menu-theme-check" id="themeCheck-twilight">✓</span>
          </li>
          <li role="menuitem" tabindex="-1" data-action="theme-xcode">
            <span class="menu-label">Xcode</span>
            <span class="menu-theme-check" id="themeCheck-xcode">✓</span>
          </li>
        </ul>
      </div>
    </nav>

    <!-- Sidebar -->
    <aside id="workspaceSidebar" class="card sidebar" aria-label="Workspace sidebar">
      <button
        id="sidebarToggleBtn"
        class="ghost sidebarToggle"
        type="button"
        aria-label="Collapse sidebar"
        aria-expanded="true"
        aria-controls="workspaceSidebarPanel"
        title="Collapse sidebar"
      >
        Collapse
      </button>

      <div id="workspaceSidebarPanel" class="sidebarPanel">
      <header>
        <div class="row space">
          <div class="title">
            <span class="icon">🗂️</span>
            <span>Workspace</span>
          </div>
        </div>

        <div class="row" style="gap:8px; flex-wrap: wrap;">
          <span id="workspaceName" class="pill" title="No folder selected">No folder selected</span>
          <span id="countsPill" class="pill" title="Counts">0 notes</span>
          <span id="temporarySessionBadge" class="pill warning" style="display: none;">Temporary Session</span>
        </div>

        <input id="searchInput" class="input" type="search" placeholder="Search filename + content..." autocomplete="off" />

        <div class="row space" style="flex-wrap: wrap;">
          <div class="row" style="gap:8px; flex-wrap: wrap;">
            <button id="sortBtn" class="ghost" title="Toggle sort mode">Sort: Name</button>
            <button id="refreshBtn" class="ghost" title="Rescan folder">Refresh</button>
          </div>
          <div class="small" id="refreshHint" title="Auto-refresh rescans periodically">Auto-refresh: On</div>
        </div>

        <div class="tagrow" id="tagRow" aria-label="Tags"></div>
      </header>

      <div class="treeWrap">
        <div id="tree" class="tree" role="tree" aria-label="Folder tree">
          <div class="small" style="padding: 8px;">Open a folder to begin.</div>
        </div>
      </div>
      </div>
    </aside>

    <!-- Main -->
    <main class="card main" aria-label="Editor and preview">
      <header>
        <span class="dirtyDot" id="dirtyDot" aria-label="Unsaved changes indicator"></span>
        <span class="filename" id="currentFilename">No note open</span>

        <div class="status" aria-live="polite">
          <span class="badge" id="statusBadge">Ready</span>
        </div>
      </header>

      <section class="split" aria-label="Editor preview split view">
        <div class="editorPane" aria-label="Markdown editor">
          <textarea id="editor" spellcheck="false" placeholder="Open a markdown file from the sidebar..."></textarea>
        </div>
        <div class="previewPane" aria-label="Markdown preview">
          <div class="preview" id="preview"></div>
        </div>
      </section>
    </main>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite">
    <div class="trow">
      <div class="tmsg" id="toastMsg"></div>
      <button id="toastCloseBtn" class="ghost" title="Dismiss">Close</button>
    </div>
  </div>

  <script>
//__INLINE_JS__
  </script>
</body>
</html>
