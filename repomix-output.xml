  const saveAsName = "note-b";
  const markdown = "# Ink regression\n\nSaved content.";

  beforeEach(() => {
    cy.visit("/ink-app.html", {
      onBeforeLoad(win) {
        Object.defineProperty(win.navigator, "userAgent", {
          value: "Windows NT 10.0",
          configurable: true,
        });

