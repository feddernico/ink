ar.collapsed .sidebarPanel{display:none}.sidebar.collapsed .sidebarToggle{display:none;width:calc(100% - 20px);writing-mode:horizontal-tb;text-orientation:mixed;letter-spacing:normal}.sidebar.collapsed{align-self:start}}
